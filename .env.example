# The world folder to run
WORLD=world

# The port the server runs on 
PORT=3000

# The secret the server uses to create/parse json web tokens. Anyone who knows it can sign in as any user, so
# generate your own (openssl rand -hex 32); the server refuses to start without one or with the old value `hyper`
JWT_SECRET=
# Only while changing JWT_SECRET on purpose: the secret that was in use before. Session tokens signed with it are
# still accepted and are renewed under the new secret, so returning users keep their identity and rank. Remove it
# after a while (tokens last 180 days). Never set it to a secret that leaked: whoever has it can sign in as anyone.
# JWT_SECRET_PREVIOUS=

# The code used to become admin in the world (type /admin <code> in chat). Wrong codes are only slowed down: the
# code itself is the protection, so use 16 or more random characters without spaces (openssl rand -hex 16).
# If left blank: everyone is an admin, except in production (NODE_ENV=production), where nobody can become one
# with a code until this is set, or ADMIN_OPEN=true says that everyone is meant to be an admin.
ADMIN_CODE=
# ADMIN_OPEN=true

# A kicked player's user id is kept out for KICK_MINUTES (default 10, 0 to 1440; 0: a kick only disconnects).
# It is a delay, not a ban: a player who clears their browser's storage is a new user. KICK_BY_ADDRESS=true makes
# new users from the kicked player's address wait too after an admin's kick (returning users are not affected);
# everyone new behind that address waits with them, and behind a proxy that does not pass client addresses
# (see UPLOAD_CLIENT_IP_HEADER) that is every new user. A restart forgets who was kicked.
# KICK_MINUTES=10
# KICK_BY_ADDRESS=false

# How often the world saves (seconds) 
# Can be set to 0 to disable saving
SAVE_INTERVAL=60

# Whether players should collide with other players
PUBLIC_PLAYER_COLLISION=false

# The maximum upload file size for models etc (mb)
PUBLIC_MAX_UPLOAD_SIZE=12

# Set to true to have the page put handles on the engine on window for the browser console (window.world,
# window.THREE, window.app, window.prims, window.preview). They are always there on localhost. Leaving them off is
# not a protection (code in the page can reach the world without them); it only keeps a stable name off the site.
PUBLIC_DEBUG=false

# Upload limits (see README "Uploads"). 0 disables a limit. Visitor = the effective rank is below builder;
# the per-address limits are 4x the per-user visitor values and never apply to a rank stored on the user
UPLOAD_CONCURRENT_TOTAL=4           # uploads in flight, all users; 503 above
UPLOAD_CONCURRENT_VISITORS=2        # the share of the total open to users without a stored builder rank; 503 above
UPLOAD_RESERVED_TRUSTED=1           # slots of the total kept for stored-rank builders and admins (below the total); 0 disables
UPLOAD_RATE_VISITOR_PER_MIN=6       # POST /api/upload per user, sliding 60 s
UPLOAD_RATE_BUILDER_PER_MIN=60
UPLOAD_CHECK_RATE_PER_MIN=60        # GET /api/upload-check per user
UPLOAD_QUOTA_VISITOR_MB=64          # new bytes per user per 24 h
UPLOAD_QUOTA_BUILDER_MB=1024
UPLOAD_QUOTA_VISITORS_TOTAL_MB=1024 # new bytes per 24 h from everyone without a stored builder rank; 503 above
UPLOAD_SLOT_TIMEOUT_S=120           # an admitted upload must deliver its body within this time
UPLOAD_MIN_FREE_MB=512              # ASSETS=local: refuse uploads (507) that would leave less free space than this, or when free space cannot be read
UPLOAD_MAX_TRACKED=40000            # untrusted identities and addresses kept in memory; while full of live records, newcomers get 503
# Proxy header carrying the client address. Read when set here, or on Fly (FLY_APP_NAME set -> fly-client-ip).
# Leave empty to key the per-address limits on the socket address
UPLOAD_CLIENT_IP_HEADER=

# Script storage (world.set in server scripts, kept in <world>/storage.json). The limits stop growth only: a file
# that is already larger is loaded as it is and may shrink
STORAGE_MAX_KEYS=1024               # keys
STORAGE_MAX_VALUE_BYTES=65536       # one value, as JSON
STORAGE_MAX_BYTES=4194304           # the whole file

# Connection limits per client address for /ws (see README "Connections and inbound packets"). 0 disables a
# limit. The address is keyed like the upload limits (UPLOAD_CLIENT_IP_HEADER / Fly-Client-IP / socket address)
# WS_CONNECT_BURST=0 requires WS_CONNECT_RATE_PER_MIN=0 too
WS_CONNECT_RATE_PER_MIN=10          # new connections per address, sustained; refused with HTTP 503 before upgrade
WS_CONNECT_BURST=20                 # new connections an address may open at once (several tabs or agents)
WS_CONNECT_RATE_PER_MIN_56=20        # IPv6 /56 sustained connections/min; 0 disables this bucket
WS_CONNECT_BURST_56=40              # IPv6 /56 burst; 0 also disables this bucket
WS_CONNECT_RATE_PER_MIN_48=40        # IPv6 /48 sustained connections/min; 0 disables this bucket
WS_CONNECT_BURST_48=80              # IPv6 /48 burst; 0 also disables this bucket
WS_CONNECT_CONCURRENT_PER_IP=8      # open connections per address
WS_CONNECT_CONCURRENT_PER_56=16     # open connections per IPv6 /56
WS_CONNECT_CONCURRENT_PER_48=32     # open connections per IPv6 /48
WS_MAX_SOCKETS=64                   # all transports, including closing ones; 64 bounds write backlogs to 64 MiB
WS_CONNECT_MAX_TRACKED=40000        # shared table of addresses and IPv6 parents; newcomers refused until entries are idle

# The public web socket url the client connects to
PUBLIC_WS_URL=ws://localhost:3000/ws

# The public url used by clients to access api (eg upload assets)
# (it, ASSETS_BASE_URL and LIVEKIT_WS_URL go into every join snapshot: at most 1,024 characters each)
PUBLIC_API_URL=http://localhost:3000/api

# How assets are stored, fetched and uploaded (local or s3)
ASSETS=local
ASSETS_BASE_URL=http://localhost:3000/assets
ASSETS_S3_URI=

# Origins the server may fetch from without the public-address check (comma separated, eg `http://10.0.0.5:9000`).
# Remote models and scripts, and the requests app scripts make with fetch() on the server, otherwise reach public
# addresses only; the assets URL above is always trusted.
OUTBOUND_TRUSTED_ORIGINS=

# By default world data is stored in a local sqlite database in the world folder
# Optionally set this to a postgres uri to store remotely, eg `postgres://username:password@host:port/database`
DB_URI=local
DB_SCHEMA=

# Whether the server should do a cleanup of unused blueprints and assets before launching (dryrun: only log).
# An asset is kept while its file name appears as a literal in the world's data or in a store script that data
# reaches. The code it follows is exactly: the store file a blueprint's script names, whatever its extension, and any
# .js store file named as a literal. Not seen, so removed: a name computed at run time or written with JavaScript
# escapes, code built at run time (code a script fetches or assembles and evaluates itself, wherever it is hosted,
# the store included) and what it names, references inside binary assets; such worlds need CLEAN=false.
# Nothing is removed when something it must read cannot be read, or ASSETS_BASE_URL is not clean (see README
# "Uploads", Clean-up).
# Assumptions: the server process is the only writer of the store, the trash and the database while it starts
# (uploads are not accepted until cleaning has finished; other processes changing those files at the same moment are
# not supported). Database tables are read whole, as the world itself reads them when it starts; the read limit
# applies to each value, not to a table's total. The assets URL serves each store file's own bytes: a redirect, a
# rewrite or a cache in front of it that answers a file's URL with something else is not supported (the clean-up
# reads the store, the world loads what the URL serves). With the local store a removal is recoverable for
# CLEAN_TRASH_DAYS;
# with S3 it is not (turn on bucket versioning).
CLEAN=true
# ASSETS=local: days removed assets stay in <world>/assets-trash/<UTC date>/ before they are deleted for good
# (0 deletes at once and empties the trash), counted by the folders' UTC dates. A trashed asset named again comes
# back at the next start-up. With ASSETS=s3 they are deleted: use bucket versioning to keep a way back
CLEAN_TRASH_DAYS=30

# LiveKit (voice chat)
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


##
# AI
# --
# AI_PROVIDER: openai, anthropic, xai, google
# AI_MODEL: claude-opus-5-5 (recommended), claude-sonnet-5-5, gpt-5, gpt-5-mini, gpt-5-nano, grok-4-0709, gemini-2.5-pro, gemini-2.5-flash
#   claude-sonnet-4-20250514 and claude-opus-4-1-20250805 are retired: requests to them fail.
# AI_EFFORT: OpenAI: minimal, low, medium, high. Anthropic (claude-opus-5-5, claude-sonnet-5-5, claude-opus-5,
#   claude-fable-5-1): low, medium, high, xhigh, max (other values use medium)
# AI_API_KEY: The api key for the selected provider
# AI_PROVIDER, AI_MODEL and AI_EFFORT are at most 128 characters each (they go into every join snapshot)
##
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# How many AI actions (create, edit, fix) builders may start, on the AI_API_KEY account: per builder one at a time
# and AI_MAX_PER_USER_PER_HOUR an hour (default 20); for the whole world AI_MAX_CONCURRENT at once (default 2) and
# AI_MAX_PER_HOUR an hour (default 60). An action runs for at most AI_MAX_SECONDS (default 600, at most 86400); then
# its provider requests are aborted. These count actions, not provider requests: a create is two requests (the
# script and its name), an edit or a fix one, and the retries the OpenAI and Anthropic SDKs make on their own (two by
# default) are not counted. Each request has an output limit: 16,000 tokens for a script, 4,096 for a name (with the
# model's thinking for Anthropic and OpenAI; without its reasoning for xAI; Google's reference does not say).
# AI_MAX_PER_USER_PER_HOUR=20
# AI_MAX_PER_HOUR=60
# AI_MAX_CONCURRENT=2
# AI_MAX_SECONDS=600
AI_EFFORT=medium
AI_API_KEY=



# Solana Token Gating Settings
SOLANA_RPC_URL=           # Server-only Solana RPC URL (preferred)
PUBLIC_RPC_URL=           # Deprecated: server fallback only, never sent to browsers. Use SOLANA_RPC_URL.
PUBLIC_TOKEN_MINT=8MXWPUCmxtmaxNSmAve3YvQNAKmAbZJ1XxSnrqN9pump          # Token mint address (set to enable token gating)
PUBLIC_REQUIRED_TOKEN_AMOUNT=100000                     # Required token amount for builder access
PUBLIC_TOKEN_DECIMALS=6                                  # Token decimals (usually 6 or 9)

# EVM Wallets (Sign-In with Ethereum)
# Comma-separated chain ids, e.g. 137 (Polygon). Empty disables EVM wallets.
# The first id goes into the sign-in message. Requires PUBLIC_API_URL (the sign-in domain is its host).
# Never put an RPC URL in a PUBLIC_ variable: every PUBLIC_ value is sent to browsers.
PUBLIC_EVM_CHAIN_IDS=
# WalletConnect (Reown) project id, 32 hex characters, from dashboard.reown.com. Adds a WalletConnect button
# (QR on desktops, wallet app links on phones). Public by design; allow only your page's domain in the dashboard.
# Empty hides WalletConnect.
PUBLIC_WALLETCONNECT_PROJECT_ID=
# Tips: built-in tokens for chain 137 (JPYC, USDC) or SYMBOL:0xaddress:decimals[:min[:max]]. Empty disables tips.
# Built-in maximums per tip during the beta: 1000 JPYC, 10 USDC; a custom token has none unless :max is given.
# Tips go wallet to wallet; the server never holds funds.
PUBLIC_EVM_TIP_TOKENS=
# Server-only EVM JSON-RPC per chain: sign-in of smart-contract wallets (EIP-1271/6492, e.g. Myna Wallet) on the
# sign-in chain, NFT checks by server scripts (player.getEvmHolding), and on-chain confirmation and chat
# announcement of tips on the sign-in chain (needs the `finalized` block tag). Never PUBLIC_.
EVM_RPC_URL_137=

# For watch mode
SOLANA_WATCH_ADDRESS=54gAnkYGqrh1suE9Cwism5tzcXMHE66hQtJgic283SDf      # Address to watch (for watch mode)

# For active mode (when server has a wallet)
SOLANA_PKEY_ARRAY=         # JSON array with wallet private key
SOLANA_WITHDRAWAL_FEE_BPS= # Optional: Fee in basis points (1 bps = 0.01%)
SOLANA_FEE_WALLET_ADDRESS= # Optional: Address where fees are sent